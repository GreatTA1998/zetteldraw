# Copy to server/.env (git-ignored); the server loads it on startup.
# Real values for the hosted setup live outside the repo.

PORT=8787
# Comma-separated bearer tokens, one per device. Use long random strings.
# After the first Google claim, these are rejected for /sync and /web by default
# (REJECT_DEVICE_TOKENS_AFTER_CLAIM=true). Keep for local/integration until Google is wired.
DEVICE_TOKENS=change-me

# Google Sign-In. Comma-separated ID token audiences (the web client id the app
# sends as serverClientId, plus any Android client ids you also accept).
# There is no package-name allowlist here. The Android OAuth client is registered
# in Google Cloud for applicationId com.zetteldraw.penpoc and the upload plus
# Play App Signing SHA-1s. Tokens from Credential Manager use the web client as aud.
GOOGLE_CLIENT_IDS=
# HMAC secret for zd1.* access tokens issued by POST /auth/google. Required when
# GOOGLE_CLIENT_IDS is set. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Accept test-google:<sub>:<email> bearers (local/integration only; never in prod).
ALLOW_TEST_GOOGLE_TOKENS=false
# Once library_claim exists, refuse DEVICE_TOKENS on /sync and /web.
REJECT_DEVICE_TOKENS_AFTER_CLAIM=true

# Supabase > Connect > Session pooler (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
# Leave sslmode out of the URL so DATABASE_CA_CERT is used for verification.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Path to the CA PEM, or the PEM itself (\n-escaped). Omit for local Postgres without TLS.
DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt

# Supabase > Storage > S3 connection. Keys come from "New access key".
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_BUCKET=zetteldraw-ink
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
