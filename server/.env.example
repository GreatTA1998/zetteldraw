# Copy to server/.env (git-ignored); the server loads it on startup.
# Real values for the hosted setup live outside the repo.

PORT=8787
# Comma-separated bearer tokens, one per device. Use long random strings.
DEVICE_TOKENS=change-me

# Supabase > Connect > Session pooler (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
# Leave sslmode out of the URL so DATABASE_CA_CERT is used for verification.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Path to the CA PEM, or the PEM itself (\n-escaped). Omit for local Postgres without TLS.
DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt

# Supabase > Storage > S3 connection. Keys come from "New access key".
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_BUCKET=zetteldraw-ink
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
