<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Documents/zetteldraw backup below Android 10; MediaStore needs no permission above. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".PenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.PenPoc"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup">
        <activity
            android:name=".CanvasActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="sensorPortrait"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.PenPoc">
            <!--
                API 36 ignores sensorPortrait on sw>=600dp. Page height is the
                portrait drawing area; a rotation would resize every sheet.
                This opt-out keeps the lock on Boox tablets. It ends at target 37.
            -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            WorkManager 2.9.1 declares this service with no type. A foreground start
            with no type is rejected from target 34 on. Sync uses a normal Worker
            (not expedited, and it never calls setForeground), so Android 16's
            quota for jobs that run beside a foreground service does not apply.
            shortService only makes the library service legal if WorkManager starts it.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="shortService"
            tools:node="merge" />
    </application>
</manifest>
