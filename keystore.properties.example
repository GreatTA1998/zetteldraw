# Copy to keystore.properties in the repo root. That file is gitignored.
# Do not commit a real keystore or real passwords.
#
# Each value can also come from the environment or a -P property. First match wins:
#   -Pzetteldraw.storeFile          ZETTELDRAW_STORE_FILE
#   -Pzetteldraw.storePassword      ZETTELDRAW_STORE_PASSWORD
#   -Pzetteldraw.keyAlias           ZETTELDRAW_KEY_ALIAS
#   -Pzetteldraw.keyPassword        ZETTELDRAW_KEY_PASSWORD
#
# storeFile is relative to the repo root unless it is an absolute path. ~ is not expanded.
# Leave all four unset to build an unsigned release bundle (fine for CI).

zetteldraw.storeFile=upload-keystore.jks
# PKCS12 (keytool's default) uses one password for the store and the key.
zetteldraw.storePassword=replace-me
zetteldraw.keyAlias=upload
zetteldraw.keyPassword=replace-me
